# Twilio SMS OTP Configuration
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
TWILIO_API_KEY=SK_your_twilio_api_key_sid
TWILIO_API_SECRET=your_twilio_api_secret
# Alternative: Primary Auth Token
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Your Twilio phone number in E.164 format (e.g. +1234567890)
TWILIO_PHONE_NUMBER=

# Razorpay Keys
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_test_secret

# Admin Dashboard Password
ADMIN_PASSWORD=admin123
